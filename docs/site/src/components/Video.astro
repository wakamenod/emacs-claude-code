---
// A scene video from public/videos, with its English and Japanese
// subtitles.  scripts/docshots.sh writes NAME.mp4 and the cue times of
// NAME.en.vtt and NAME.ja.vtt; the page's language picks the track
// that is on when the video starts.
//
//   <Video name="switch" label="What the video shows" />
//
// public/ is not run through Astro's pipeline, so nothing puts the base
// in front of these URLs but this file.
interface Props {
	name: string;
	label: string;
}

const { name, label } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const url = (file: string) => `${base}/videos/${file}`;
const ja = Astro.locals.starlightRoute.lang === 'ja';
---

<video
	class="ecc-video"
	src={url(`${name}.mp4`)}
	aria-label={label}
	title={label}
	autoplay
	muted
	loop
	playsinline
	controls
	preload="auto"
>
	<track kind="subtitles" srclang="en" label="English" src={url(`${name}.en.vtt`)} default={!ja} />
	<track kind="subtitles" srclang="ja" label="日本語" src={url(`${name}.ja.vtt`)} default={ja} />
</video>

<style>
	.ecc-video {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 0.25rem;
	}
</style>
