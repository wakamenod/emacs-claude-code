*.elc
# Generated by `loaddefs-generate' when the package is used straight from a
# checkout rather than installed: a personal init may keep it fresh so that
# the ;;;###autoload cookies take effect without listing every command by hand.
/ecc-autoloads.el
*~
.#*
/test/snapshots/*.new
/.eask/
/dist/
.DS_Store

# Personal Claude Code settings; .claude/settings.json is the shared one
/.claude/settings.local.json

# Worktrees Claude Code checks out here.  They are checkouts of this very
# repository, so `git clean' skips them as repositories of their own even
# with -x; only -ff takes one away, which is as true without this line.
/.claude/worktrees/

# Specification documents, kept locally but out of the repository.
# Named one by one so that the documentation site can live under /docs/.
# These five have nothing to do with docs/site/; do not tidy them into a
# glob, which would hide the site source with them.  The site's own build
# output is ignored by docs/site/.gitignore.
/REQUIREMENTS.md
/IMPLEMENTATION_PLAN.md
/docs/btw.md
/docs/decisions.md
/docs/defcustom-inventory.md
/docs/phase9-ui-redesign.md
/docs/verified.md
/tmp
